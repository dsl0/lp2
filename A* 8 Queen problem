def astar(g, h, s, goal):
    open = [(0, s)]; cost = {s: 0}; par = {s: None}
    while open:
        open.sort(); _, cur = open.pop(0)
        if cur == goal:
            p = []
            while cur: p.append(cur); cur = par[cur]
            return p[::-1]
        for nb, w in g[cur]:
            nc = cost[cur] + w
            if nb not in cost or nc < cost[nb]:
                cost[nb] = nc; open.append((nc + h[nb], nb)); par[nb] = cur

g = {'A':[('B',1),('C',3)],'B':[('D',1)],'C':[('D',1)],'D':[]}
h = {'A':3,'B':2,'C':1,'D':0}
print("A* Path:", astar(g, h, 'A', 'D'))
