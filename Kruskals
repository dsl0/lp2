def kruskals_mst(n, edges):
    parent = list(range(n))

    def find(x):
        parent[x] = find(parent[x]) if parent[x] != x else x
        return parent[x]

    def union(x, y):
        rx, ry = find(x), find(y)

        if rx == ry:
            return False

        parent[ry] = rx
        return True

    mst, total = [], 0

    for w, u, v in sorted(edges):

        if union(u, v):
            mst.append((u, v, w))
            total += w

        if len(mst) == n - 1:
            break

    return mst, total


edges = [
    (2,0,1),
    (3,0,2),
    (7,0,3),
    (8,1,3),
    (5,1,4),
    (4,2,3),
    (6,3,4)
]

print(kruskals_mst(5, edges))
