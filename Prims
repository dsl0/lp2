import heapq

def prims_mst(graph,start=0):
 visited,heap,mst,total=set(),[(0,start,-1)],[],0
 while heap and len(visited)<len(graph):
  w,u,p=heapq.heappop(heap)
  if u in visited: continue
  visited.add(u); total+=w
  if p!=-1: mst.append((p,u,w))
  for ew,v in graph[u]:
   if v not in visited: heapq.heappush(heap,(ew,v,u))
 return mst,total

graph={
 0:[(2,1),(3,2),(7,3)],
 1:[(2,0),(5,4),(8,3)],
 2:[(3,0),(4,3)],
 3:[(7,0),(8,1),(4,2),(6,4)],
 4:[(5,1),(6,3)]
}

print(prims_mst(graph))
