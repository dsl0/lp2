import tkinter as tk
from tkinter import scrolledtext
import random
import datetime

# Chatbot intents
intents = {
    "greeting": {
        "patterns": ["hi", "hello", "hey"],
        "responses": ["Hello!", "Hi there!", "Hey! How can I help you?"]
    },
    "goodbye": {
        "patterns": ["bye", "goodbye"],
        "responses": ["Goodbye!", "Take care!", "See you soon!"]
    },
    "ai": {
        "patterns": ["what is ai", "define ai"],
        "responses": ["Artificial Intelligence is the simulation of human intelligence in machines."]
    },
    "thanks": {
        "patterns": ["thanks", "thank you"],
        "responses": ["You're welcome!", "Happy to help!", "Anytime!"]
    },
    "joke": {
        "patterns": ["joke", "tell me a joke"],
        "responses": [
            "Why do programmers prefer dark mode? Because light attracts bugs 😆",
            "Why was the computer cold? It left its Windows open 😂"
        ]
    }
}

# Chatbot function
def chatbot(user_input):
    user_input = user_input.lower()

    if "time" in user_input:
        return "Current time is " + datetime.datetime.now().strftime("%H:%M:%S")

    if "date" in user_input:
        return "Today's date is " + str(datetime.date.today())

    for intent in intents.values():
        for pattern in intent["patterns"]:
            if pattern in user_input:
                return random.choice(intent["responses"])

    return "Sorry, I didn't understand that."

# Send message function
def send_message():
    user_message = entry_box.get()
    if user_message.strip() == "":
        return

    chat_area.insert(tk.END, "You: " + user_message + "\n")
    bot_response = chatbot(user_message)
    chat_area.insert(tk.END, "Bot: " + bot_response + "\n\n")

    entry_box.delete(0, tk.END)
    chat_area.yview(tk.END)

# GUI setup
window = tk.Tk()
window.title("Python Chatbot")
window.geometry("500x500")

chat_area = scrolledtext.ScrolledText(window, wrap=tk.WORD, width=60, height=20)
chat_area.pack(pady=10)
chat_area.config(state='normal')

entry_box = tk.Entry(window, width=40)
entry_box.pack(side=tk.LEFT, padx=10, pady=10)

send_button = tk.Button(window, text="Send", command=send_message)
send_button.pack(side=tk.LEFT, pady=10)

window.mainloop()
